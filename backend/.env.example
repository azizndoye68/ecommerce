# Copiez ce fichier sous le nom .env puis remplacez toutes les valeurs.
DB_URL=jdbc:postgresql://localhost:5432/ecommerce_db
DB_USERNAME=postgres
DB_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=2592000000
ADMIN_EMAIL=admin@ecommerce.com
ADMIN_PASSWORD=
ADMIN_NOM=Admin
ADMIN_PRENOM=Super
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200
AUTH_RATE_LIMIT=10
AUTH_RATE_LIMIT_WINDOW=60
SESSION_CLEANUP_MS=21600000
# Gmail SMTP local: utilisez un mot de passe d'application Google dans MAIL_PASSWORD.
# Gardez les vraies valeurs dans backend/.env, jamais dans Git.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=
FRONTEND_URL=http://localhost:4200
PAIEMENT_SIMULATION_ACTIVE=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UNITECHPAY_BASE_URL=https://api.unitech.sn/api.php
UNITECHPAY_API_KEY=
# create_orange_om ou create_orange_maxit
UNITECHPAY_ORANGE_ACTION=create_orange_om
# Facultatives; renseigne des URL HTTPS publiques si tu veux personnaliser le retour navigateur.
UNITECHPAY_CALLBACK_SUCCESS=
UNITECHPAY_CALLBACK_CANCEL=
# À configurer dans UniTech Pay vers l'URL HTTPS publique du backend :
# https://<backend-public>/api/webhooks/unitechpay
